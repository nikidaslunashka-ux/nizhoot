PORT=3000
# Base URL Override (Opsional: otomatis terdeteksi jika deploy di Render via RENDER_EXTERNAL_URL, atau gunakan IP lokal saat development)
# BASE_URL=https://nizhoot.onrender.com
SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/2PACX-1vTroUpzMnECgKIvr4LVjNK5k-WzMZ8DSIDdD8PM61Y6tx4shCqqCVm3mTw35aUzMtGGyH8Ku_JQaS5w/pub?output=csv

# Google Sheets API & Google Drive API (Service Account)
SPREADSHEET_ID=your_google_spreadsheet_id_here
DRIVE_ROOT_FOLDER_ID=your_google_drive_folder_id_here
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Akun internal v2. Gunakan spreadsheet PRIVAT, jangan publish tab akun ke web.
# Disarankan terpisah dari spreadsheet soal bila soal masih memakai publish-to-web.
AUTH_SPREADSHEET_ID=your_private_account_spreadsheet_id
# Set hanya bila aplikasi berada tepat di belakang satu reverse proxy tepercaya.
TRUST_PROXY=0
# Sekali saja: npm run bootstrap-admin, kemudian hapus password bootstrap.
BOOTSTRAP_ADMIN_USERNAME=superadmin
BOOTSTRAP_ADMIN_NAME=Super Admin
BOOTSTRAP_ADMIN_PASSWORD=
